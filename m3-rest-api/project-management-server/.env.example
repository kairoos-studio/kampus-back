# Copiar para .env e ajustar. Valores falsos, só para desenvolvimento local.
PORT=5005
# MongoDB local (ver "npm run db:local" no README)
MONGODB_URI=mongodb://127.0.0.1:27017/kampus
# Segredo para assinar os JWT. Gerar um valor aleatório próprio; este é só um exemplo.
TOKEN_SECRET=troca-isto-por-um-segredo-local-falso
# Origem do front (CORS). localhost:5173 já é aceite por omissão no código.
ORIGIN=http://localhost:5173
